{
  "id": "unraid-mgmt",
  "name": "Unraid Manager",
  "version": "1.0.12",
  "description": "Monitor and manage several Unraid servers — Docker control (start/stop/restart/update) built for 60+ containers, plus array, disks, parity, UPS, VMs, and notifications. Needs Unraid 7.2+ (built-in GraphQL API).",
  "entry": "index.html",
  "served": true,
  "server": "server.js",
  "knob": true,
  "options": [
    { "key": "server1Name", "label": "Server 1 name", "type": "text", "default": "Unraid", "help": "Rail label for this server." },
    { "key": "server1Url", "label": "Server 1 URL", "type": "text", "default": "", "serverOnly": true, "help": "e.g. http://192.168.1.25 — the Unraid webGUI address (do not add /graphql). Requires Unraid 7.2+." },
    { "key": "server1Key", "label": "Server 1 API key", "type": "secret", "default": "", "serverOnly": true, "help": "Settings > Management Access > API > API Keys > create a key with the admin role (needed for start/stop/update)." },
    { "key": "server1Stats", "label": "Server 1 stats-api URL", "type": "text", "default": "", "serverOnly": true, "help": "Optional add-on (github.com/TeeJS/stats), e.g. http://192.168.1.25:19998 — adds live GPU and per-container CPU/memory the Unraid API can't provide." },

    { "key": "addServer2", "label": "＋ Add a second server", "type": "bool", "default": false },
    { "key": "server2Name", "label": "Server 2 name", "type": "text", "default": "", "showIf": { "key": "addServer2", "value": true } },
    { "key": "server2Url", "label": "Server 2 URL", "type": "text", "default": "", "serverOnly": true, "showIf": { "key": "addServer2", "value": true }, "help": "The second Unraid server's webGUI address." },
    { "key": "server2Key", "label": "Server 2 API key", "type": "secret", "default": "", "serverOnly": true, "showIf": { "key": "addServer2", "value": true } },
    { "key": "server2Stats", "label": "Server 2 stats-api URL", "type": "text", "default": "", "serverOnly": true, "showIf": { "key": "addServer2", "value": true }, "help": "Optional — see Server 1 stats-api URL." },

    { "key": "addServer3", "label": "＋ Add a third server", "type": "bool", "default": false, "showIf": { "key": "addServer2", "value": true } },
    { "key": "server3Name", "label": "Server 3 name", "type": "text", "default": "", "showIf": { "key": "addServer3", "value": true } },
    { "key": "server3Url", "label": "Server 3 URL", "type": "text", "default": "", "serverOnly": true, "showIf": { "key": "addServer3", "value": true } },
    { "key": "server3Key", "label": "Server 3 API key", "type": "secret", "default": "", "serverOnly": true, "showIf": { "key": "addServer3", "value": true } },
    { "key": "server3Stats", "label": "Server 3 stats-api URL", "type": "text", "default": "", "serverOnly": true, "showIf": { "key": "addServer3", "value": true }, "help": "Optional — see Server 1 stats-api URL." },

    { "key": "addServer4", "label": "＋ Add a fourth server", "type": "bool", "default": false, "showIf": { "key": "addServer3", "value": true } },
    { "key": "server4Name", "label": "Server 4 name", "type": "text", "default": "", "showIf": { "key": "addServer4", "value": true } },
    { "key": "server4Url", "label": "Server 4 URL", "type": "text", "default": "", "serverOnly": true, "showIf": { "key": "addServer4", "value": true } },
    { "key": "server4Key", "label": "Server 4 API key", "type": "secret", "default": "", "serverOnly": true, "showIf": { "key": "addServer4", "value": true } },
    { "key": "server4Stats", "label": "Server 4 stats-api URL", "type": "text", "default": "", "serverOnly": true, "showIf": { "key": "addServer4", "value": true }, "help": "Optional — see Server 1 stats-api URL." },

    { "key": "verifySsl", "label": "Verify HTTPS certificate", "type": "bool", "default": true, "help": "Uncheck only if a server URL is https with a self-signed certificate." },
    { "key": "allowControls", "label": "Allow container controls", "type": "bool", "default": true, "help": "When off, the app is read-only (no start/stop/update/array/VM actions)." },
    {
      "key": "refreshSeconds",
      "label": "Refresh interval",
      "type": "select",
      "default": "10",
      "choices": [["5", "5 seconds"], ["10", "10 seconds"], ["30", "30 seconds"]],
      "help": "How often the panel polls each server."
    }
  ]
}
