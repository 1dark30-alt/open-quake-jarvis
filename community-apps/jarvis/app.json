{
  "id": "jarvis",
  "name": "JARVIS Mark 55",
  "entry": "jarvisview.html",
  "served": true,
  "server": "server.js",
  "options": [
    {
      "key": "endpoint",
      "label": "JARVIS Server URL",
      "type": "text",
      "default": "http://127.0.0.1:8000"
    },
    {
      "key": "pin",
      "label": "Pairing PIN",
      "type": "secret",
      "default": "QUAKE"
    },
    {
      "key": "gemini_api_key",
      "label": "Gemini API Key",
      "type": "secret",
      "default": ""
    }
  ]
}
